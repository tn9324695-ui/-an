@model MenuItem
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.RelatedItems as List<MenuItem> ?? new List<MenuItem>();
}

<section class="w-full py-12 px-margin bg-surface">
    <div class="max-w-7xl mx-auto">
        <div class="mb-6">
            <a asp-action="Menu" class="font-label-sm text-label-sm uppercase text-secondary text-decoration-none">&larr; Quay lại Thực đơn đương đại</a>
        </div>

        <div class="bg-surface-container-low rounded-2xl p-8 lg:p-12 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-16">
            <div class="lg:col-span-6 rounded-xl overflow-hidden shadow-lg h-96">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover" />
            </div>
            <div class="lg:col-span-6">
                <div class="flex flex-wrap gap-2 mb-3">
                    <span class="px-3 py-1 rounded-full bg-primary text-on-primary font-label-sm text-[10px] uppercase">@Model.Category?.Name</span>
                    @if (!string.IsNullOrEmpty(Model.DietaryTags))
                    {
                        <span class="px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-[10px] uppercase">@Model.DietaryTags</span>
                    }
                </div>
                <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-md text-primary mb-1">@Model.Name</h1>
                @if (!string.IsNullOrEmpty(Model.FrenchSubtitle))
                {
                    <p class="font-label-md text-secondary uppercase tracking-widest mb-4">@Model.FrenchSubtitle</p>
                }
                <p class="font-body-lg text-on-surface-variant leading-relaxed mb-6">@Model.Description</p>
                @if (!string.IsNullOrEmpty(Model.WinePairingNote))
                {
                    <div class="p-3 rounded-lg bg-surface mb-6 flex items-center gap-2 text-sm text-secondary">
                        <span class="material-symbols-outlined text-[20px]">wine_bar</span>
                        <span>@Model.WinePairingNote</span>
                    </div>
                }
                <div class="font-headline-md text-primary mb-6">@Model.EffectivePrice.ToString("N0") ₫</div>

                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="space-y-4">
                    <input type="hidden" name="menuItemId" value="@Model.Id" />
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="font-label-sm text-label-sm uppercase text-on-surface-variant block mb-1">Số phần</label>
                            <input type="number" name="quantity" value="1" min="1" max="20" class="w-full px-3 py-2.5 rounded bg-surface border border-outline-variant/50" />
                        </div>
                        <div class="sm:col-span-2">
                            <label class="font-label-sm text-label-sm uppercase text-on-surface-variant block mb-1">Ghi chú riêng cho Bếp trưởng</label>
                            <input type="text" name="note" class="w-full px-3 py-2.5 rounded bg-surface border border-outline-variant/50" placeholder="VD: Độ chín Medium Rare, không tiêu..." />
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-3 pt-2">
                        <button type="submit" class="px-8 py-3.5 bg-primary text-on-primary font-label-md text-label-md uppercase tracking-wider rounded hover:bg-secondary transition-colors">
                            + Thêm Vào Danh Sách Gọi Món
                        </button>
                        <a asp-controller="Reservation" asp-action="Index" class="px-6 py-3.5 bg-surface border border-outline-variant text-primary font-label-md text-label-md uppercase tracking-wider rounded hover:bg-surface-container transition-colors text-decoration-none">
                            Đặt Bàn Thưởng Thức
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

