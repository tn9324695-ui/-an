@{
    ViewData["Title"] = "Câu Chuyện Thương Hiệu & Bếp Trưởng";
}

<div class="flex flex-col w-full">
    <!-- 1. Hero Header: Khúc Mở Đầu -->
    <section class="relative w-full pt-16 pb-24 md:py-32 overflow-hidden">
        <div class="absolute -top-24 right-1/4 w-96 h-96 bg-secondary-container/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-32 left-10 w-[500px] h-[500px] bg-surface-container/60 rounded-full blur-3xl pointer-events-none"></div>
        <div class="max-w-7xl mx-auto px-margin relative z-10">
            <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
                <div class="flex items-center gap-3 mb-6">
                    <span class="w-8 h-[1px] bg-secondary"></span>
                    <span class="font-label-sm text-label-sm uppercase tracking-[0.25em] text-secondary">Câu Chuyện &amp; Triết Lý • L'Atelier Fine Dining</span>
                    <span class="w-8 h-[1px] bg-secondary"></span>
                </div>
                <h1 class="font-headline-lg md:font-display-lg text-headline-lg-mobile md:text-display-lg text-primary tracking-tight leading-tight mb-8">
                    Hành Trình Giao Thoa Giữa Đất Mẹ Bản Địa &amp; Nghệ Thuật Ẩm Thực Đương Đại
                </h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed mb-12">
                    Nơi từng trải nghiệm vị giác được nuôi dưỡng từ lòng trắc ẩn với đất trời bản địa, chắt lọc qua lăng kính kỹ nghệ Haute Cuisine chuẩn mực của Pháp để biến mỗi bữa tiệc thành một tác phẩm nghệ thuật thi vị.
                </p>
                <div class="w-full bg-surface-container-low rounded-xl p-8 md:p-12 shadow-sm flex flex-col md:flex-row items-center gap-8 text-left relative overflow-hidden">
                    <div class="w-20 h-20 md:w-24 md:h-24 rounded-full overflow-hidden shrink-0 shadow-md">
                        <img class="w-full h-full object-cover" alt="Executive Chef Alain Vũ" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCUzsRLx-BG1V-AnVLrPYbCR6LVY8KxL98DRslEQPq9EIKLBEjbPK5vpj_1p9jxG1m4v85gkWnjYkNu5dy_zYWA7usJsWKVacV5F0LVL0q20NMNnLKtKInsmyATFDuVsHSjeWAYXH2fJ5hiIBUMiOhXannQRzvDCLlpO4n5vEiMEVFMVP3bbGl587ATzUrBnnWSbXZQBWKBycb9XAEEoOQYJMp9hZBqZn0Fp-YtKKFD" />
                    </div>
                    <div class="flex-1">
                        <span class="material-symbols-outlined text-secondary/40 text-4xl leading-none select-none mb-2">format_quote</span>
                        <p class="font-headline-sm text-headline-sm italic text-primary leading-snug mb-3 font-normal">
                            “Chúng tôi không đơn thuần nấu nướng, chúng tôi kể câu chuyện về đất trời, mùa vụ và con người qua từng nốt hương vị.”
                        </p>
                        <div class="flex items-center gap-3">
                            <span class="font-title-md text-title-md text-primary font-medium">Alain Vũ</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                            <span class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant">Bếp Trưởng Điều Hành &amp; Đồng Sáng Lập</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Nguồn Gốc & Sự Hình Thành -->
    <section class="w-full py-20 bg-surface-container-lowest">
        <div class="max-w-7xl mx-auto px-margin">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter lg:gap-space-xl items-center">
                <div class="lg:col-span-5 flex flex-col justify-center">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary">KHỞI NGUYÊN TỪ NĂM 2018</span>
                    </div>
                    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary tracking-tight mb-6">
                        Nốt Trầm Tĩnh Lặng Giữa Trung Tâm Đô Thị Sầm Uất
                    </h2>
                    <div class="space-y-4 font-body-md text-body-md text-on-surface-variant leading-relaxed mb-10">
                        <p>
                            Tọa lạc trong khuôn viên một biệt thự Pháp cổ kính trăm năm trên trục đường Đồng Khởi, L'Atelier ra đời với một ước vọng mộc mạc: tạo lập một “xưởng sáng tạo thủ công” nơi ẩm thực vượt thoát khỏi chuẩn mực bàn ăn đơn thuần để trở thành chất xúc tác chạm đến tâm hồn.
                        </p>
                        <p>
                            Chúng tôi cố ý giới hạn không gian chỉ đúng <span class="text-primary font-medium">14 bàn tiệc</span> phục vụ mỗi tối. Sự hữu hạn này là lời cam kết trân quý nhất gửi đến mỗi vị khách: sự hiện diện trọn vẹn và không gian tĩnh lặng tuyệt đối.
                        </p>
                    </div>
                    <div class="grid grid-cols-3 gap-4 pt-6 bg-surface-container-low p-6 rounded-lg">
                        <div class="flex flex-col">
                            <span class="font-headline-md text-headline-md text-primary font-light">6+</span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mt-1">Năm hoàn thiện triết lý</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-headline-md text-headline-md text-primary font-light">100%</span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mt-1">Nông sản bản địa tuyển chọn</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-headline-md text-headline-md text-secondary font-light">Selected</span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mt-1">Michelin Guide 2024</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-7 relative">
                    <div class="grid grid-cols-12 gap-4 items-end">
                        <div class="col-span-8 rounded-xl overflow-hidden shadow-lg h-[460px] relative group">
                            <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" alt="Biệt thự 128 Đồng Khởi" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBu7-Bx7ayfmVBrSW-yeVpcRyLkqZvDsyk7WA5qc_EjCkAbh5CC7X0DTAdEpHDOt9xgKA9odMarOFPgAsijJyuQJ3ZNAGG8Tbo8wAHVDey-wtKOU_EsOTv99MhuDI8lh2ugmySFgP5rJpNjervSgHtijnAYPy12Fst5iNA45KuQEjh6sDtczppDD_hpF4g-TCNQYEtCsGWQHypmy82TvsaSoc3vSlUHKehViZtptyMC" />
                            <div class="absolute inset-0 bg-gradient-to-t from-primary/70 via-transparent to-transparent opacity-80"></div>
                            <div class="absolute bottom-6 left-6 text-on-primary">
                                <p class="font-label-sm text-label-sm uppercase tracking-widest text-primary-fixed-dim mb-0">Kiến Trúc Di Sản</p>
                                <p class="font-title-md text-title-md mb-0">128 Đồng Khởi, Quận 1</p>
                            </div>
                        </div>
                        <div class="col-span-4 -ml-6 mb-8 rounded-xl overflow-hidden shadow-2xl h-[320px] relative z-10 bg-surface-container">
                            <img class="w-full h-full object-cover" alt="Bản sắc L'Atelier" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBWjfM-_RXpniGML6HLV1ZldMvljbeeqk1GFTzqYu2CvfauKjquZ2vvHRCP0f1PWvlFtbHtPmCyRTd6moHm_gHUh7Y4V8RexbHUj8BusyVMKOO-Y3b2wL9BoYRmV7_XLwn4CKMqTHKvNE9IUw-JIMbYe2c2oUkgqcstnr5oNrxZw_ud-K6vWMy7ivMwRfGq4-YrqfTb1CEsTdVfZh2XXqBg-VbMSR7cGXE6Kl43XhQL" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Đội Ngũ Dẫn Dắt Nghệ Thuật -->
    <section class="w-full py-24 bg-surface">
        <div class="max-w-7xl mx-auto px-margin">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
                <div>
                    <span class="font-label-sm text-label-sm uppercase tracking-[0.2em] text-secondary block mb-2">ĐỘI NGŨ DẪN DẮT NGHỆ THUẬT</span>
                    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary tracking-tight">Những Bàn Tay Định Hình Mỹ Cảm</h2>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-md mb-0">
                    Sự hòa quyện giữa kỷ luật ẩm thực chuẩn mực châu Âu và tình yêu sâu đậm dành cho thảm thực vật trù phú của dải đất hình chữ S.
                </p>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-lg">
                <div class="bg-surface-container-lowest rounded-xl p-8 lg:p-12 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="w-full h-[380px] rounded-lg overflow-hidden mb-8 relative bg-surface-container">
                            <img class="w-full h-full object-cover" alt="Alain Vũ" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCSxQWQCuK_NcE0r5jxwCzzbTVIxJurA5RHrkgOJALSCD05Y7YgnahH5DzdmbnQL2V74AO5WeNvDwGyv426CJmrtQeJFe67CNucVgkYnSJ8m998RA8Q1WUf_zTphUp71O7aEBpLnmCUf68mIP2VqyzM-HsL_W0ORCcnxUsi5VeTGbJtYT18U95RFHA2VOnxPz5khtXsEgbmC0ji68n1ExFEjdK8Q9WeYdfFxpkLcA8b" />
                            <div class="absolute top-4 left-4 bg-primary/80 backdrop-blur-md text-on-primary px-3.5 py-1.5 rounded font-label-sm text-label-sm uppercase tracking-widest">
                                Executive Chef
                            </div>
                        </div>
                        <div class="flex items-baseline justify-between mb-2">
                            <h3 class="font-headline-md text-headline-md text-primary">Alain Vũ</h3>
                            <span class="font-label-md text-label-md text-secondary tracking-widest uppercase">Lyon &amp; Paris Trained</span>
                        </div>
                        <p class="font-title-md text-title-md text-on-surface-variant italic mb-6">Bếp Trưởng Điều Hành &amp; Giám Đốc Ẩm Thực</p>
                        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-6">
                            Trải qua hơn 12 năm rèn giũa tại các nhà hàng 2 và 3 sao Michelin danh tiếng tại Lyon và Paris, Alain trở về Việt Nam với sứ mệnh đánh thức hương vị tiềm ẩn của thảo mộc bản địa Sa Pa, hạt dổi Tây Bắc, tiêu rừng Phú Quốc và hải sản đánh bắt trong ngày.
                        </p>
                    </div>
                    <div class="pt-6 bg-surface-container-low rounded-lg p-5 flex items-center justify-between">
                        <span class="font-body-md text-body-md text-primary font-medium">Phong cách ẩm thực:</span>
                        <span class="font-label-md text-label-md text-secondary uppercase tracking-wider">Contemporary Neo-Vietnamese</span>
                    </div>
                </div>

                <div class="bg-surface-container-lowest rounded-xl p-8 lg:p-12 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="w-full h-[380px] rounded-lg overflow-hidden mb-8 relative bg-surface-container">
                            <img class="w-full h-full object-cover" alt="Marcella Trần" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAFmjOqyPWcPD-hvfIZmBLRPMF-DvYxYOFkBGypfUiGMLa1I0-7cqe-uKILbJuNMEd0VqjKiVJ8XLYBJkhx2xFfZEOfcdhiEkTgkcAEs2x3m6p3E5h9eiCw6_Fj8vmjEct6YCTgID6BN9WmuNsCmD0xix-xAKTh9WTd4IduhkqLokxSxudl9xIQOAAWm0NVq0Pjk7bKzdagcDwTDFIlis-qsoUVojcOXWBu-W0kF3R8" />
                            <div class="absolute top-4 left-4 bg-primary/80 backdrop-blur-md text-on-primary px-3.5 py-1.5 rounded font-label-sm text-label-sm uppercase tracking-widest">
                                Head Sommelier
                            </div>
                        </div>
                        <div class="flex items-baseline justify-between mb-2">
                            <h3 class="font-headline-md text-headline-md text-primary">Marcella Trần</h3>
                            <span class="font-label-md text-label-md text-secondary tracking-widest uppercase">ASI Certified Sommelier</span>
                        </div>
                        <p class="font-title-md text-title-md text-on-surface-variant italic mb-6">Chuyên Gia Rượu Vang &amp; Phục Vụ</p>
                        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-6">
                            Với chứng chỉ Court of Master Sommeliers và kinh nghiệm quản lý hầm rượu tại Bordeaux, Marcella xem việc ghép đôi rượu vang (wine pairing) như việc điều phối thanh âm cho một bản giao hưởng ẩm thực.
                        </p>
                    </div>
                    <div class="pt-6 bg-surface-container-low rounded-lg p-5 flex items-center justify-between">
                        <span class="font-body-md text-body-md text-primary font-medium">Bộ sưu tập hầm rượu:</span>
                        <span class="font-label-md text-label-md text-secondary uppercase tracking-wider">350+ Nhãn Vang Grand Cru &amp; Bio</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Lời Mời Dùng Tiệc -->
    <section class="w-full py-20 bg-surface-container-low">
        <div class="max-w-7xl mx-auto px-margin">
            <div class="bg-primary-container text-on-primary rounded-2xl p-10 md:p-16 relative overflow-hidden shadow-2xl text-center">
                <span class="font-label-sm text-label-sm uppercase tracking-[0.25em] text-primary-fixed-dim mb-4 block">
                    ĐÓN CHÀO BẠN ĐẾN VỚI L'ATELIER
                </span>
                <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-[#fcf9f4] tracking-tight mb-6">
                    Mỗi Bữa Tiệc Là Một Buổi Hòa Nhạc Giác Quan Riêng Biệt
                </h2>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a asp-controller="Reservation" asp-action="Index" class="px-8 py-4 bg-[#fcf9f4] text-primary font-label-md text-label-md uppercase tracking-wider rounded hover:bg-secondary-fixed transition-colors text-decoration-none">
                        Đặt Bàn Trước
                    </a>
                    <a asp-controller="Home" asp-action="Menu" class="px-8 py-4 border border-primary-fixed/40 text-[#fcf9f4] hover:bg-[#35251c] font-label-md text-label-md uppercase tracking-wider rounded transition-colors text-decoration-none">
                        Khám Phá Thực Đơn
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>

