@model List<Reservation>
@{
    ViewData["Title"] = "Quản Lý Phiếu Đặt Bàn";
    var tables = ViewBag.Tables as List<DiningTable> ?? new List<DiningTable>();
    string[] statuses = new[] { "Chờ xác nhận", "Đã xác nhận", "Đã nhận bàn", "Đã hủy" };
}

<section class="w-full py-12 px-margin bg-surface">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
            <div>
                <a asp-action="Index" class="font-label-sm text-label-sm uppercase text-secondary">&larr; Quay lại Bảng điều khiển</a>
                <h1 class="font-headline-md text-headline-md text-primary mt-1">Quản Lý Phiếu Đặt Bàn L'Atelier (@Model.Count phiếu)</h1>
            </div>
            <a asp-action="Tables" class="px-4 py-2.5 bg-primary text-on-primary font-label-sm text-label-sm uppercase rounded hover:bg-secondary">
                Sơ Đồ Bàn Tiệc
            </a>
        </div>

        <div class="space-y-4">
            @foreach (var r in Model)
            {
                <div class="bg-surface-container-low p-6 rounded-xl shadow-sm border border-outline-variant/40 grid grid-cols-1 lg:grid-cols-12 gap-4 items-center">
                    <div class="lg:col-span-4">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-label-md text-secondary font-medium">#LA-@r.Id.ToString("D4")</span>
                            <span class="font-title-md text-primary">@r.CustomerName</span>
                        </div>
                        <div class="text-xs text-on-surface-variant space-y-0.5">
                            <div>SĐT: <strong class="text-primary">@r.CustomerPhone</strong> | Email: @(r.CustomerEmail ?? "—")</div>
                            @if (!string.IsNullOrEmpty(r.CompanyVatInfo))
                            {
                                <div>VAT: @r.CompanyVatInfo</div>
                            }
                            <div>Dịp: <span class="text-secondary">@r.Occasion</span></div>
                        </div>
                    </div>

                    <div class="lg:col-span-4 text-xs text-on-surface-variant space-y-1">
                        <div><strong class="text-primary">Lịch hẹn:</strong> @r.ReservationDate.ToString("dd/MM/yyyy") · @r.ReservationTime</div>
                        <div><strong class="text-primary">Số khách:</strong> @r.GuestGroupLabel (@r.NumberOfGuests người)</div>
                        <div><strong class="text-primary">Không gian chọn:</strong> @r.SeatingArea</div>
                        <div><strong class="text-primary">Thực đơn:</strong> <span class="text-secondary">@r.SelectedMenuPackage</span> @(r.HasWinePairing ? "(+Wine Pairing)" : "")</div>
                        <div><strong class="text-primary">Tạm tính:</strong> @r.EstimatedTotal.ToString("N0") ₫</div>
                        @if (!string.IsNullOrEmpty(r.SpecialRequests))
                        {
                            <div class="text-error"><strong>Lưu ý dị ứng/Yêu cầu:</strong> @r.SpecialRequests</div>
                        }
                    </div>

                    <div class="lg:col-span-4">
                        <form asp-action="UpdateReservationStatus" method="post" class="flex flex-col sm:flex-row gap-2">
                            <input type="hidden" name="id" value="@r.Id" />
                            <select name="diningTableId" class="px-3 py-2 rounded bg-surface text-xs text-on-surface border border-outline-variant/50">
                                <option value="">-- Xếp bàn cụ thể --</option>
                                @foreach (var t in tables)
                                {
                                    <option value="@t.Id" selected="@(r.DiningTableId == t.Id)">@t.TableNumber - @t.Area (@t.Capacity chỗ)</option>
                                }
                            </select>
                            <select name="status" class="px-3 py-2 rounded bg-surface text-xs text-on-surface border border-outline-variant/50">
                                @foreach (var st in statuses)
                                {
                                    <option value="@st" selected="@(r.Status == st)">@st</option>
                                }
                            </select>
                            <button type="submit" class="px-4 py-2 bg-primary text-on-primary font-label-sm text-label-sm uppercase rounded hover:bg-secondary">
                                Lưu
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
